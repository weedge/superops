{
  "description": "MR 只读审查",
  "required": [
    "findings"
  ],
  "properties": {
    "round": {
      "type": "integer"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "problem"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "problem": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          }
        }
      }
    }
  }
}
